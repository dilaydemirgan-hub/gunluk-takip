# Bu dosya şablondur, git'e girer. Gerçek değerler .env / .env.local içine.

# .env — tarayıcıya gider, anon anahtarı zaten herkese açıktır
# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# .env.local — yalnızca `npm run seed` için, asla commit etme
# Supabase Dashboard → Settings → API → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
